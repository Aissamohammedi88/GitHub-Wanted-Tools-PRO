# HTTP HANDLER
# ══════════════════════════════════════════════════════════════════════════════
class Handler(http.server.BaseHTTPRequestHandler):

def log_message(self, *a):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8"):
if isinstance(body, str):
body = body.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
try:
self.wfile.write(body)
except Exception:
pass

def _read_json(self):
try:
n = int(self.headers.get("Content-Length", 0))
if n == 0:
return {}
return json.loads(self.rfile.read(n).decode("utf-8"))
except Exception:
return {}

def do_GET(self):
p = urllib.parse.urlparse(self.path)
path = p.path
qs = urllib.parse.parse_qs(p.query)

if path in ("/", "/index.html"):
self._send(200, PAGE)

elif path.startswith("/api/discussion/"):
did = path.split("/")[-1]
tree = THREADS.get_tree(did)
if tree:
self._send(200, json.dumps(tree, ensure_ascii=False, default=str), "application/json; charset=utf-8")
else:
self._send(404, json.dumps({"error": "not_found"}), "application/json")

elif path == "/api/discussions":
repo = qs.get("repo", [""])[0]
discussions = THREADS.list_by_repo(repo, sort="score", limit=100)
self._send(200, json.dumps({"discussions": discussions, "count": len(discussions)},
ensure_ascii=False, default=str), "application/json; charset=utf-8")

elif path.startswith("/api/summarize/"):
did = path.split("/")[-1]
s = SUMMARIZER.summarize(did)
if s:
self._send(200, json.dumps(s, ensure_ascii=False, default=str), "application/json; charset=utf-8")
else:
self._send(404, json.dumps({"error": "not_found"}), "application/json")

elif path.startswith("/api/votes/"):
parts = path.split("/")
if len(parts) >= 5:
target_type = parts[3]
target_id = parts[4]
self._send(200, json.dumps(VOTES.info(target_type, target_id),
ensure_ascii=False), "application/json")
else:
self._send(400, json.dumps({"error": "invalid"}), "application/json")

elif path == "/api/stats":
conn = db()
stats = {
"users": conn.execute("SELECT COUNT(*) FROM users").fetchone()[0],
"discussions": conn.execute("SELECT COUNT(*) FROM discussions").fetchone()[0],
"comments": conn.execute("SELECT COUNT(*) FROM comments").fetchone()[0],
"votes": conn.execute("SELECT COUNT(*) FROM votes").fetchone()[0],
"reactions": conn.execute("SELECT COUNT(*) FROM reactions").fetchone()[0],
"tags": conn.execute("SELECT COUNT(*) FROM tags").fetchone()[0],
"subscriptions": conn.execute("SELECT COUNT(*) FROM subscriptions").fetchone()[0],
"notifications": conn.execute("SELECT COUNT(*) FROM notifications").fetchone()[0],
}
conn.close()
self._send(200, json.dumps(stats), "application/json")

elif path == "/api/users/top":
users = USERS.top(20)
self._send(200, json.dumps({"users": users}, ensure_ascii=False, default=str),
"application/json; charset=utf-8")

elif path == "/api/health":
self._send(200, json.dumps({
"status": "ok", "version": VERSION, "author": AUTHOR,
}), "application/json")

else:
self._send(404, json.dumps({"error": "not_found"}), "application/json")

def do_POST(self):
p = urllib.parse.urlparse(self.path)
path = p.path
body = self._read_json()

if path == "/api/discussion":
result = THREADS.create(
repo=body.get("repo", ""),
title=body.get("title", ""),
body=body.get("body", ""),
author=body.get("author", "anon"),
parent_id=body.get("parent_id"),
tags=body.get("tags", []),
)
self._send(200, json.dumps(result, ensure_ascii=False), "application/json")

elif path == "/api/comment":
cid = THREADS.add_comment(
discussion_id=body.get("discussion_id", ""),
body=body.get("body", ""),
author=body.get("author", "anon"),
parent_id=body.get("parent_id"),
)
self._send(200, json.dumps({"id": cid, "ok": True}), "application/json")

elif path == "/api/check-duplicate":
dups = DUPLICATES.find_duplicates(
repo=body.get("repo", ""),
title=body.get("title", ""),
body=body.get("body", ""),
threshold=float(body.get("threshold", 0.5)),
)
self._send(200, json.dumps({"duplicates": dups, "count": len(dups)},
ensure_ascii=False, default=str), "application/json")

elif path == "/api/vote":
result = VOTES.vote(
target_type=body.get("target_type", "discussion"),
target_id=body.get("target_id", ""),
user_id=body.get("user_id", ""),
direction=int(body.get("direction", 1)),
)
self._send(200, json.dumps(result), "application/json")

elif path == "/api/unvote":
result = VOTES.unvote(
target_type=body.get("target_type", "discussion"),
target_id=body.get("target_id", ""),
user_id=body.get("user_id", ""),
)
self._send(200, json.dumps(result), "application/json")

elif path == "/api/reaction":
result = REACTIONS.add(
target_type=body.get("target_type", "discussion"),
target_id=body.get("target_id", ""),
user_id=body.get("user_id", ""),
emoji=body.get("emoji", ""),
)
self._send(200, json.dumps(result), "application/json")

elif path == "/api/search":
results = SEARCH.search(
repo=body.get("repo", ""),
query=body.get("query", ""),
mode=body.get("mode", "auto"),
limit=int(body.get("limit", 50)),
)
self._send(200, json.dumps({
"query": body.get("query", ""),
"count": len(results),
"results": results,
}, ensure_ascii=False, default=str), "application/json")

elif path == "/api/export":
path_out = EXPORTER.export_discussions(
repo=body.get("repo", ""),
format_=body.get("format", "json"),
)
self._send(200, json.dumps({"path": path_out, "ok": path_out is not None}),
"application/json")

elif path == "/api/backup":
path_out = EXPORTER.backup()
self._send(200, json.dumps({"path": path_out, "ok": True}), "application/json")

else:
self._send(404, json.dumps({"error": "not_found"}), "application/json")



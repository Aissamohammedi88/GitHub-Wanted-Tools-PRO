function renderThread(d,depth){
if(!d)return '<p>Introuvable</p>';
depth=depth||0;
var h='<div class="thread d'+Math.min(depth,4)+'">';
h+='<div class="t">'+esc(d.title)+'</div>';
h+='<div class="meta">'+esc(d.author)+' - '+esc(d.created_at)+' <span class="score">'+((d.upvotes||0)-(d.downvotes||0))+'</span></div>';
h+='<div class="body">'+esc(d.body)+'</div>';
if(d.tags&&d.tags.length){d.tags.forEach(t=>h+='<span class="tag">'+esc(t)+'</span>');}
if(d.comments&&d.comments.length){
h+='<div style="margin-top:10px"><b style="color:#4ade80;font-size:11px">COMMENTAIRES</b></div>';
h+=renderComments(d.comments);
}
if(d.children&&d.children.length){
h+='<div style="margin-top:10px"><b style="color:#00d4ff;font-size:11px">SOUS-DISCUSSIONS ('+d.children.length+')</b></div>';
d.children.forEach(c=>h+=renderThread(c,depth+1));
}
h+='</div>';
return h;
}

function renderComments(cs){
var h='';
cs.forEach(function(c){
h+='<div class="comment d'+Math.min(c.depth_in_tree||0,3)+'">';
h+='<div class="meta">'+esc(c.author)+' - '+esc(c.created_at)+'</div>';
h+='<div>'+esc(c.body)+'</div>';
h+='</div>';
if(c.children&&c.children.length){h+=renderComments(c.children);}
});
return h;
}


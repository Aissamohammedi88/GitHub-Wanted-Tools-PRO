# MODULE 7 — SEARCH (wildcard + FTS5)
# ══════════════════════════════════════════════════════════════════════════════
class SearchEngine:

@staticmethod
def wildcard_to_regex(pattern):
escaped = re.escape(pattern)
escaped = escaped.replace(r"\*", ".*")
escaped = escaped.replace(r"\?", ".")
return re.compile("^" + escaped + "$", re.IGNORECASE)

@staticmethod
def wildcard_to_like(pattern):
escaped = pattern.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
return escaped.replace("*", "%").replace("?", "_")

def wildcard_search(self, repo, pattern, search_in="all", limit=50):
regex = self.wildcard_to_regex(pattern)
like = self.wildcard_to_like(pattern)

conn = db()
if repo:
rows = conn.execute("SELECT * FROM discussions WHERE repo=?", (repo,)).fetchall()
else:
rows = conn.execute("SELECT * FROM discussions").fetchall()

results = []
for r in rows:
d = dict(r)
d["tags"] = [t["tag"] for t in conn.execute(
"SELECT tag FROM tags WHERE discussion_id=?", (r["id"],)
).fetchall()]

matched = None
if search_in in ("title", "all") and regex.search(d["title"]):
matched = "title"
elif search_in in ("body", "all") and regex.search(d["body"]):
matched = "body"
elif search_in in ("author", "all") and regex.search(d["author"]):
matched = "author"
elif search_in in ("tags", "all"):
for t in d["tags"]:
if regex.search(t):
matched = "tags"
break

if matched:
d["matched_field"] = matched
results.append(d)

conn.close()
results.sort(key=lambda x: (x["score"] or 0), reverse=True)
return results[:limit]

def fulltext_search(self, repo, query, limit=50):
"""Recherche full-text via SQLite FTS5"""
conn = db()

# Nettoyer la requete (FTS5 syntax)
safe_query = re.sub(r"[^\w\s]", " ", query)
terms = [t for t in safe_query.split() if len(t) > 1]

if not terms:
conn.close()
return []

fts_query = " OR ".join(terms)

try:
rows = conn.execute(
"""SELECT d.* FROM discussions d
JOIN discussions_fts fts ON d.rowid = fts.rowid
WHERE discussions_fts MATCH ?
ORDER BY rank
LIMIT ?""",
(fts_query, limit)
).fetchall()
except Exception:
# Fallback
rows = conn.execute(
"SELECT * FROM discussions WHERE title LIKE ? OR body LIKE ? LIMIT ?",
("%" + query + "%", "%" + query + "%", limit)
).fetchall()

result = []
for r in rows:
d = dict(r)
if repo and d["repo"] != repo:
continue
d["tags"] = [t["tag"] for t in conn.execute(
"SELECT tag FROM tags WHERE discussion_id=?", (r["id"],)
).fetchall()]
result.append(d)

conn.close()
return result

def search(self, repo, query, mode="auto", limit=50):
if mode == "auto":
# Si wildcards presents
if "*" in query or "?" in query:
return self.wildcard_search(repo, query, "all", limit)
return self.fulltext_search(repo, query, limit)
elif mode == "wildcard":
return self.wildcard_search(repo, query, "all", limit)
elif mode == "fulltext":
return self.fulltext_search(repo, query, limit)
return []


SEARCH = SearchEngine()



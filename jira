# MODULE 2 — THREADS (sous-discussions imbriquees)
# ══════════════════════════════════════════════════════════════════════════════
class ThreadManager:

MAX_DEPTH = 20

def create(self, repo, title, body, author, parent_id=None, tags=None):
conn = db()

# Determine root and depth
root_id = None
depth = 0
if parent_id:
parent = conn.execute(
"SELECT root_id, depth FROM discussions WHERE id=?", (parent_id,)
).fetchone()
if parent:
root_id = parent["root_id"] or parent_id
depth = parent["depth"] + 1
if depth > self.MAX_DEPTH:
conn.close()
return {"error": "max_depth_exceeded"}

did = uid("disc")
conn.execute(
"""INSERT INTO discussions
(id, repo, title, body, author, parent_id, root_id, depth, created_at, updated_at)
VALUES (?,?,?,?,?,?,?,?,?,?)""",
(did, repo, title, body, author, parent_id, root_id, depth, now_iso(), now_iso())
)

if tags:
for t in tags:
if t.strip():
conn.execute(
"INSERT OR IGNORE INTO tags (discussion_id, tag) VALUES (?,?)",
(did, t.strip().lower())
)

# Update parent comment_count
if parent_id:
conn.execute(
"UPDATE discussions SET comment_count = comment_count + 1, updated_at=? WHERE id=?",
(now_iso(), parent_id)
)

# FTS index
try:
conn.execute(
"INSERT INTO discussions_fts (rowid, title, body, tags) VALUES ((SELECT rowid FROM discussions WHERE id=?), ?, ?, ?)",
(did, title, body, ",".join(tags) if tags else "")
)
except Exception:
pass

conn.commit()
conn.close()

# Notify subscribers of parent
if parent_id:
self._notify_subscribers(parent_id, "reply", did, "Nouvelle reponse : " + title[:60])

return {"id": did, "root_id": root_id or did, "depth": depth}

def get(self, discussion_id):
conn = db()
row = conn.execute("SELECT * FROM discussions WHERE id=?", (discussion_id,)).fetchone()
if not row:
conn.close()
return None
d = dict(row)
d["tags"] = [t["tag"] for t in conn.execute(
"SELECT tag FROM tags WHERE discussion_id=?", (discussion_id,)
).fetchall()]
conn.close()
return d

def get_tree(self, discussion_id, max_depth=None):
"""Recupere un arbre complet recursivement"""
max_depth = max_depth or self.MAX_DEPTH
conn = db()

def build(did, current_depth=0):
if current_depth > max_depth:
return None
row = conn.execute("SELECT * FROM discussions WHERE id=?", (did,)).fetchone()
if not row:
return None
d = dict(row)
d["depth_in_tree"] = current_depth
d["tags"] = [t["tag"] for t in conn.execute(
"SELECT tag FROM tags WHERE discussion_id=?", (did,)
).fetchall()]
d["comments"] = self._comments_tree(conn, did)
children = conn.execute(
"SELECT id FROM discussions WHERE parent_id=? ORDER BY score DESC, created_at DESC",
(did,)
).fetchall()
d["children"] = []
for c in children:
child = build(c["id"], current_depth + 1)
if child:
d["children"].append(child)
return d

tree = build(discussion_id)
conn.close()
return tree

def _comments_tree(self, conn, discussion_id):
rows = conn.execute(
"SELECT * FROM comments WHERE discussion_id=? AND deleted=0 ORDER BY created_at ASC",
(discussion_id,)
).fetchall()

comments = [dict(r) for r in rows]
by_parent = defaultdict(list)
for c in comments:
by_parent[c["parent_id"]].append(c)

def build(parent_id, depth=0):
result = []
for c in by_parent.get(parent_id, []):
c["depth_in_tree"] = depth
c["children"] = build(c["id"], depth + 1)
result.append(c)
return result

return build(None)

def add_comment(self, discussion_id, body, author, parent_id=None):
conn = db()

depth = 0
if parent_id:
parent = conn.execute("SELECT depth FROM comments WHERE id=?", (parent_id,)).fetchone()
if parent:
depth = parent["depth"] + 1

cid = uid("cmt")
conn.execute(
"""INSERT INTO comments
(id, discussion_id, parent_id, author, body, created_at, updated_at, depth)
VALUES (?,?,?,?,?,?,?,?)""",

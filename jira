# MODULE 3 — DUPLICATE DETECTION (TF-IDF + cosine)
# ══════════════════════════════════════════════════════════════════════════════
class DuplicateDetector:

STOPWORDS = {
"le", "la", "les", "un", "une", "des", "de", "du", "et", "ou", "a",
"au", "aux", "en", "dans", "sur", "pour", "par", "avec", "ce", "cet",
"cette", "ces", "qui", "que", "quoi", "dont", "ou", "est", "sont",
"etre", "avoir", "je", "tu", "il", "elle", "nous", "vous", "ils",
"elles", "je", "me", "te", "se", "mon", "ton", "son", "notre",
"votre", "leur", "the", "a", "an", "is", "are", "and", "or", "for",
"with", "in", "to", "of", "on", "at", "by", "it", "this", "that",
"not", "no", "yes", "be", "been", "have", "has", "had", "do", "does",
"did", "but", "if", "then", "else", "when", "where", "why", "how",
}

@staticmethod
def tokenize(text):
text = text.lower()
text = re.sub(r"[^\w\s]", " ", text)
words = text.split()
return [w for w in words if len(w) > 2 and w not in DuplicateDetector.STOPWORDS]

@staticmethod
def vectorize(tokens):
return Counter(tokens)

@staticmethod
def cosine(v1, v2):
keys = set(v1.keys()) | set(v2.keys())
dot = sum(v1.get(k, 0) * v2.get(k, 0) for k in keys)
n1 = math.sqrt(sum(v * v for v in v1.values()))
n2 = math.sqrt(sum(v * v for v in v2.values()))
if n1 == 0 or n2 == 0:
return 0.0
return dot / (n1 * n2)

def compute_tfidf(self, docs):
"""docs : liste de (id, tokens)"""
N = len(docs)
df = Counter()
for _, tokens in docs:
for w in set(tokens):
df[w] += 1

vectors = {}
for doc_id, tokens in docs:
tf = Counter(tokens)
vec = {}
for w, c in tf.items():
idf = math.log((N + 1) / (df[w] + 1)) + 1
vec[w] = c * idf
vectors[doc_id] = vec
return vectors

def find_duplicates(self, repo, title, body, threshold=0.5, limit=10):
"""Cherche les discussions similaires par TF-IDF + cosine"""
query_text = title + " " + body
query_tokens = self.tokenize(query_text)
if not query_tokens:
return []

conn = db()
rows = conn.execute(
"SELECT id, title, body, author, created_at, upvotes, downvotes, score FROM discussions WHERE repo=? AND status='open'",
(repo,)
).fetchall()
conn.close()

if not rows:
return []

docs = [(query_tokens, query_tokens)]
for r in rows:
tokens = self.tokenize(r["title"] + " " + r["body"])
docs.append((r["id"], tokens))

vectors = self.compute_tfidf(docs)
query_vec = vectors[query_tokens]

results = []
for r in rows:
cand_vec = vectors.get(r["id"], {})
sim = self.cosine(query_vec, cand_vec)
if sim >= threshold:
results.append({
"id": r["id"],
"title": r["title"],
"author": r["author"],
"created_at": r["created_at"],
"score": r["score"] or 0,
"similarity": round(sim * 100, 1),
"excerpt": r["body"][:300],
})

results.sort(key=lambda x: x["similarity"], reverse=True)
return results[:limit]


DUPLICATES = DuplicateDetector()



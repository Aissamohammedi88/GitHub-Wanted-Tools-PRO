# MODULE 4 — SUMMARIZER (extractif)
# ══════════════════════════════════════════════════════════════════════════════
class Summarizer:

def summarize(self, discussion_id):
conn = db()
disc = conn.execute("SELECT * FROM discussions WHERE id=?", (discussion_id,)).fetchone()
if not disc:
conn.close()
return None

texts = [("OP", disc["author"], disc["body"])]
authors = Counter({disc["author"]: 1})

comments = conn.execute(
"SELECT author, body FROM comments WHERE discussion_id=? AND deleted=0",
(discussion_id,)
).fetchall()
for c in comments:
texts.append(("comment", c["author"], c["body"]))
authors[c["author"]] += 1

children = conn.execute(
"SELECT id, title, body, author, score FROM discussions WHERE parent_id=?",
(discussion_id,)
).fetchall()
child_summaries = []
for ch in children:
texts.append(("sub", ch["author"], ch["body"]))
authors[ch["author"]] += 1
child_summaries.append({
"id": ch["id"],
"title": ch["title"],
"author": ch["author"],
"score": ch["score"] or 0,
})

conn.close()

# Extraction
all_text = "\n\n".join(t[2] for t in texts)
sentences = self._split_sentences(all_text)

if not sentences:
return {"error": "no_content"}

# TF-IDF scoring
docs = [(str(i), DuplicateDetector.tokenize(s)) for i, s in enumerate(sentences)]
vectors = DuplicateDetector.compute_tfidf(docs)
scored = []
for i, sent in enumerate(sentences):
vec = vectors.get(str(i), {})
score = sum(vec.values()) / max(1, len(vec))
scored.append((score, i, sent))

scored.sort(reverse=True)

# Top 5 uniques
top = []
seen = set()
for _, _, sent in scored:
key = sent[:60].lower()
if key in seen:
continue
seen.add(key)
top.append(sent)
if len(top) >= 5:
break

# Themes : top mots
all_tokens = []
for s in sentences:
all_tokens.extend(DuplicateDetector.tokenize(s))
themes = [w for w, _ in Counter(all_tokens).most_common(10) if len(w) > 4]

return {
"discussion_id": discussion_id,
"title": disc["title"],
"author": disc["author"],
"created_at": disc["created_at"],
"score": disc["score"] or 0,
"total_sentences": len(sentences),
"total_chars": len(all_text),
"participants": dict(authors.most_common(10)),
"participant_count": len(authors),
"points": top,
"themes": themes,
"child_discussions": child_summaries,
"child_count": len(child_summaries),
}

def _split_sentences(self, text):
text = re.sub(r"\n+", " ", text)
parts = re.split(r"(?<=[.!?])\s+", text)
return [p.strip() for p in parts if len(p.strip()) > 25]


SUMMARIZER = Summarizer()



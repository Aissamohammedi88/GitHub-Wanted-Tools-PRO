def export_discussions(self, repo, format_="json"):
discussions = THREADS.list_by_repo(repo, sort="score", limit=1000)

if format_ == "json":
path = EXPORT_DIR / ("discussions_" + repo.replace("/", "_") + ".json")
path.write_text(json.dumps(discussions, indent=2, ensure_ascii=False, default=str), encoding="utf-8")
return str(path)

if format_ == "markdown":
path = EXPORT_DIR / ("discussions_" + repo.replace("/", "_") + ".md")
lines = ["# Discussions : " + repo, ""]
for d in discussions:
lines.append("## " + d["title"])
lines.append("")
lines.append("**Auteur** : " + d["author"])
lines.append("**Score** : " + str(d["score"] or 0))
lines.append("**Date** : " + d["created_at"])
lines.append("")
lines.append(d["body"])
lines.append("")
lines.append("---")
lines.append("")
path.write_text("\n".join(lines), encoding="utf-8")
return str(path)

if format_ == "csv":
path = EXPORT_DIR / ("discussions_" + repo.replace("/", "_") + ".csv")
with open(path, "w", newline="", encoding="utf-8") as f:
writer = csv.writer(f)
writer.writerow(["id", "title", "author", "score", "upvotes", "downvotes", "created_at", "comment_count"])
for d in discussions:
writer.writerow([
d["id"], d["title"], d["author"], d["score"] or 0,
d["upvotes"] or 0, d["downvotes"] or 0,
d["created_at"], d["comment_count"] or 0,
])
return str(path)

return None


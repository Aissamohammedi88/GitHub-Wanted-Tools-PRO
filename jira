)
conn.execute(
"UPDATE discussions SET comment_count = comment_count + 1, updated_at=? WHERE id=?",
(now_iso(), discussion_id)
)
conn.commit()
conn.close()

self._notify_subscribers(discussion_id, "comment", cid, "Nouveau commentaire")
return cid


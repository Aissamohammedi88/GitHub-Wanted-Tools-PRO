# MODULE 5 — VOTES (unique par user)
# ══════════════════════════════════════════════════════════════════════════════
class VoteManager:

def vote(self, target_type, target_id, user_id, direction=1):
if direction not in (-1, 1):
return {"ok": False, "reason": "invalid_direction"}

conn = db()
existing = conn.execute(
"SELECT direction FROM votes WHERE target_type=? AND target_id=? AND user_id=?",
(target_type, target_id, user_id)
).fetchone()

if existing:
# Change vote
if existing["direction"] == direction:
conn.close()
return {"ok": False, "reason": "already_voted", "message": "Tu as deja vote"}

# Update
conn.execute(
"UPDATE votes SET direction=? WHERE target_type=? AND target_id=? AND user_id=?",
(direction, target_type, target_id, user_id)
)
delta = direction - existing["direction"]
else:
conn.execute(
"INSERT INTO votes (target_type, target_id, user_id, direction, created_at) VALUES (?,?,?,?,?)",
(target_type, target_id, user_id, direction, now_iso())
)
delta = direction

# Update target
if target_type == "discussion":
if direction == 1:
conn.execute(
"UPDATE discussions SET upvotes = upvotes + 1, score = score + ? WHERE id=?",
(delta, target_id)
)
else:
conn.execute(
"UPDATE discussions SET downvotes = downvotes + 1, score = score + ? WHERE id=?",
(delta, target_id)
)
elif target_type == "comment":
if direction == 1:
conn.execute(
"UPDATE comments SET upvotes = upvotes + 1 WHERE id=?",
(target_id,)
)
else:
conn.execute(
"UPDATE comments SET downvotes = downvotes + 1 WHERE id=?",
(target_id,)
)

conn.commit()
conn.close()

# Karma
author = self._get_author(target_type, target_id)
if author:
USERS.add_karma(author, delta * 2)

return {"ok": True, "direction": direction, "delta": delta}

def _get_author(self, target_type, target_id):
conn = db()
if target_type == "discussion":
row = conn.execute("SELECT author FROM discussions WHERE id=?", (target_id,)).fetchone()
elif target_type == "comment":
row = conn.execute("SELECT author FROM comments WHERE id=?", (target_id,)).fetchone()
else:
row = None
conn.close()
return row["author"] if row else None

def unvote(self, target_type, target_id, user_id):
conn = db()
existing = conn.execute(
"SELECT direction FROM votes WHERE target_type=? AND target_id=? AND user_id=?",
(target_type, target_id, user_id)
).fetchone()

if not existing:
conn.close()
return {"ok": False, "reason": "no_vote"}

direction = existing["direction"]
conn.execute(
"DELETE FROM votes WHERE target_type=? AND target_id=? AND user_id=?",
(target_type, target_id, user_id)
)

if target_type == "discussion":
if direction == 1:
conn.execute(
"UPDATE discussions SET upvotes = MAX(0, upvotes - 1), score = score - 1 WHERE id=?",
(target_id,)
)
else:
conn.execute(
"UPDATE discussions SET downvotes = MAX(0, downvotes - 1), score = score + 1 WHERE id=?",
(target_id,)
)
elif target_type == "comment":
if direction == 1:
conn.execute("UPDATE comments SET upvotes = MAX(0, upvotes - 1) WHERE id=?", (target_id,))
else:
conn.execute("UPDATE comments SET downvotes = MAX(0, downvotes - 1) WHERE id=?", (target_id,))

conn.commit()
conn.close()
return {"ok": True, "direction": direction}

def info(self, target_type, target_id):
conn = db()
up = conn.execute(
"SELECT COUNT(*) FROM votes WHERE target_type=? AND target_id=? AND direction=1",
(target_type, target_id)
).fetchone()[0]
down = conn.execute(
"SELECT COUNT(*) FROM votes WHERE target_type=? AND target_id=? AND direction=-1",
(target_type, target_id)
).fetchone()[0]
voters = conn.execute(
"SELECT user_id, direction FROM votes WHERE target_type=? AND target_id=?",
(target_type, target_id)
).fetchall()
conn.close()
return {
"upvotes": up,
"downvotes": down,
"score": up - down,
"voters": [{"user_id": v["user_id"], "direction": v["direction"]} for v in voters],
}

def has_voted(self, target_type, target_id, user_id):

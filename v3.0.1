# HTTP HANDLER
# ══════════════════════════════════════════════════════════════════════════════
class Handler(http.server.BaseHTTPRequestHandler):

def log_message(self, *a):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8"):
if isinstance(body, str):
body = body.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
try:
self.wfile.write(body)
except Exception:
pass

def _read_json(self):
try:
n = int(self.headers.get("Content-Length", 0))
if n == 0:
return {}
return json.loads(self.rfile.read(n).decode("utf-8"))
except Exception:
return {}

def do_GET(self):
p = urllib.parse.urlparse(self.path)
path = p.path
qs = urllib.parse.parse_qs(p.query)

if path in ("/", "/index.html"):
self._send(200, PAGE)

elif path == "/api/analyze":
url = qs.get("url", [""])[0]
if not url:
self._send(400, json.dumps({"error": "URL requise"}), "application/json")
return
owner, repo = parse_url(url)
if not owner or not repo:
self._send(400, json.dumps({"error": "URL invalide"}), "application/json")
return
client = GitHubClient(TOKEN)
engine = AnalyticsEngine(client, owner, repo)
result = engine.analyze()
self._send(200, json.dumps(result, ensure_ascii=False, default=str),
"application/json; charset=utf-8")

elif path == "/api/reports":
reports = []
for d in (REPORTS_DIR, BATCH_DIR):
for f in sorted(d.glob("*.json"), reverse=True)[:30]:
reports.append({
"name": f.name,
"size": f.stat().st_size,
"modified": datetime.fromtimestamp(f.stat().st_mtime).isoformat(),
})
self._send(200, json.dumps({"reports": reports}), "application/json")

elif path == "/api/health":
self._send(200, json.dumps({
"status": "ok", "version": VERSION, "author": AUTHOR,
"has_token": bool(TOKEN),
}), "application/json")

else:
self._send(404, json.dumps({"error": "not_found"}), "application/json")

def do_POST(self):
p = urllib.parse.urlparse(self.path)
path = p.path
body = self._read_json()

if path == "/api/batch":
repos = body.get("repos", [])
if len(repos) < 2:
self._send(400, json.dumps({"error": "Minimum 2 repos"}), "application/json")
return
if len(repos) > 20:
self._send(400, json.dumps({"error": "Maximum 20 repos"}), "application/json")
return

client = GitHubClient(TOKEN)
batch = BatchAnalyzer(client)
result = batch.analyze_batch(repos)
path_out = batch.save_batch_report(result)
result["report_path"] = path_out
self._send(200, json.dumps(result, ensure_ascii=False, default=str),
"application/json; charset=utf-8")

else:
self._send(404, json.dumps({"error": "not_found"}), "application/json")



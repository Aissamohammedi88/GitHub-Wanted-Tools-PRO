# HTTP CLIENT
# ══════════════════════════════════════════════════════════════════════════════
class GitHubClient:

def __init__(self, token=""):
self.token = token
self.rate_remaining = 60
self.rate_limit = 60
self.rate_reset = 0
self.cache = {}
self.request_count = 0

def get(self, path, timeout=15, cache_ttl=300):
cache_key = path
if cache_key in self.cache:
data, ts = self.cache[cache_key]
if time.time() - ts < cache_ttl:
return data

url = API + path if not path.startswith("http") else path
req = urllib.request.Request(url)
req.add_header("User-Agent", "GitHubAnalytics/3.0")
req.add_header("Accept", "application/vnd.github.v3+json")
if self.token:
req.add_header("Authorization", "token " + self.token)

self.request_count += 1

try:
with urllib.request.urlopen(req, timeout=timeout) as r:
self.rate_remaining = int(r.headers.get("X-RateLimit-Remaining", 60))
self.rate_limit = int(r.headers.get("X-RateLimit-Limit", 60))
self.rate_reset = int(r.headers.get("X-RateLimit-Reset", 0))
data = json.loads(r.read().decode("utf-8", errors="replace"))
self.cache[cache_key] = (data, time.time())
return data
except urllib.error.HTTPError as e:
if e.code == 404:
return {"__error__": "not_found", "code": 404}
if e.code == 403:
return {"__error__": "rate_limit", "code": 403}
return {"__error__": "HTTP " + str(e.code), "code": e.code}
except Exception as e:
return {"__error__": str(e)}

def paginate(self, path, max_pages=3, per_page=100):
results = []
sep = "&" if "?" in path else "?"
for page in range(1, max_pages + 1):
url = path + sep + "per_page=" + str(per_page) + "&page=" + str(page)
data = self.get(url)
if not isinstance(data, list):
break
if not data:
break
results.extend(data)
if len(data) < per_page:
break
return results


def parse_url(url):
url = url.strip().rstrip("/")
if url.endswith(".git"):
url = url[:-4]
if "github.com/" in url:
parts = url.split("github.com/")[1].split("/")
if len(parts) >= 2:
return parts[0], parts[1].split("?")[0].split("#")[0]
if "/" in url and "://" not in url:
parts = url.split("/")
if len(parts) >= 2:
return parts[0], parts[1]
return None, None


# ══════════════════════════════════════════════════════════════════════════════
# ANALYTICS ENGINE (single repo)
# ══════════════════════════════════════════════════════════════════════════════
class AnalyticsEngine:

def __init__(self, client, owner, repo):
self.client = client
self.owner = owner
self.repo = repo
self.full = owner + "/" + repo
self.data = {}
self.scores = {}
self.metrics = {}
self.issues_analysis = {}

def fetch(self):
info("Fetch " + self.full)
base = "/repos/" + self.full

r = self.client.get(base)
if r.get("__error__"):
return False

self.data["repo"] = r
self.data["languages"] = self.client.get(base + "/languages")
self.data["contributors"] = self.client.paginate(base + "/contributors", 2)
self.data["commits"] = self.client.paginate(base + "/commits", 2)
self.data["releases"] = self.client.paginate(base + "/releases", 1)
self.data["branches"] = self.client.paginate(base + "/branches", 1)
self.data["tags"] = self.client.paginate(base + "/tags", 1)
self.data["issues_open"] = self.client.paginate(base + "/issues?state=open", 3)
self.data["issues_closed"] = self.client.paginate(base + "/issues?state=closed", 2)
self.data["pulls_open"] = self.client.paginate(base + "/pulls?state=open", 2)
self.data["pulls_closed"] = self.client.paginate(base + "/pulls?state=closed", 1)
self.data["forks"] = self.client.paginate(base + "/forks", 1)

default_branch = r.get("default_branch", "main")
self.data["tree"] = self.client.get(base + "/git/trees/" + default_branch + "?recursive=1")

return True

def compute_metrics(self):
r = self.data["repo"]

self.metrics["stars"] = r.get("stargazers_count", 0)
self.metrics["forks"] = r.get("forks_count", 0)
self.metrics["watchers"] = r.get("subscribers_count", 0)
self.metrics["open_issues"] = r.get("open_issues_count", 0)
self.metrics["size_kb"] = r.get("size", 0)
self.metrics["size_mb"] = round(r.get("size", 0) / 1024, 2)
self.metrics["license"] = (r.get("license") or {}).get("name") if r.get("license") else "Aucune"
self.metrics["language"] = r.get("language", "Inconnu")
self.metrics["topics"] = r.get("topics", [])

now = datetime.now(timezone.utc)

try:
created = datetime.fromisoformat(r["created_at"].replace("Z", "+00:00"))
self.metrics["age_days"] = (now - created).days
self.metrics["age_years"] = round((now - created).days / 365.25, 2)
except Exception:
self.metrics["age_days"] = 0
self.metrics["age_years"] = 0

try:
pushed = datetime.fromisoformat(r["pushed_at"].replace("Z", "+00:00"))
self.metrics["days_since_push"] = (now - pushed).days
except Exception:
self.metrics["days_since_push"] = 9999

# Contributors
contributors = self.data.get("contributors", [])
if isinstance(contributors, list):
self.metrics["contributors"] = len(contributors)
else:
self.metrics["contributors"] = 0

# Commits
commits = self.data.get("commits", [])
if isinstance(commits, list):
self.metrics["recent_commits"] = len(commits)
self.metrics["commit_frequency"] = self._commit_frequency(commits)
else:
self.metrics["recent_commits"] = 0
self.metrics["commit_frequency"] = {}

# Issues
issues_open = self.data.get("issues_open", [])
issues_closed = self.data.get("issues_closed", [])
self.metrics["issues_open_count"] = len(issues_open) if isinstance(issues_open, list) else 0
self.metrics["issues_closed_count"] = len(issues_closed) if isinstance(issues_closed, list) else 0
total = self.metrics["issues_open_count"] + self.metrics["issues_closed_count"]
self.metrics["issues_total"] = total
self.metrics["issue_resolution_rate"] = round(
self.metrics["issues_closed_count"] / total * 100, 1
) if total > 0 else 0.0

# PRs
pulls_open = self.data.get("pulls_open", [])
pulls_closed = self.data.get("pulls_closed", [])
self.metrics["pulls_open_count"] = len(pulls_open) if isinstance(pulls_open, list) else 0
self.metrics["pulls_closed_count"] = len(pulls_closed) if isinstance(pulls_closed, list) else 0

# Branches, tags, releases
self.metrics["branches"] = len(self.data.get("branches", [])) if isinstance(self.data.get("branches"), list) else 0
self.metrics["tags"] = len(self.data.get("tags", [])) if isinstance(self.data.get("tags"), list) else 0
self.metrics["releases"] = len(self.data.get("releases", [])) if isinstance(self.data.get("releases"), list) else 0

# Languages
langs = self.data.get("languages", {})
if isinstance(langs, dict) and langs:
total_l = sum(langs.values())
self.metrics["languages"] = {k: round(v / total_l * 100, 2) for k, v in langs.items()}
self.metrics["languages_count"] = len(langs)
else:
self.metrics["languages"] = {}
self.metrics["languages_count"] = 0

# Documentation
self.metrics["documentation"] = self._check_documentation()

# Traffic
self.metrics["traffic"] = self._estimate_traffic()

# Issues analysis (SMART FILTER)
self.issues_analysis = self._analyze_issues_smart()

def _commit_frequency(self, commits):
months = defaultdict(int)
now = datetime.now(timezone.utc)
for c in commits:
try:
date_str = c.get("commit", {}).get("author", {}).get("date", "")
dt = datetime.fromisoformat(date_str.replace("Z", "+00:00"))
months[dt.strftime("%Y-%m")] += 1
except Exception:
continue
result = {}
for i in range(11, -1, -1):
d = now - timedelta(days=30 * i)
result[d.strftime("%Y-%m")] = months.get(d.strftime("%Y-%m"), 0)
return result

def _check_documentation(self):
tree = self.data.get("tree", {})
files = []
if isinstance(tree, dict) and "tree" in tree:
files = [f.get("path", "") for f in tree.get("tree", []) if f.get("type") == "blob"]

files_lower = [f.lower() for f in files]

checks = {
"readme": any("readme" in f for f in files_lower),
"license": any(f.startswith("license") for f in files_lower),
"contributing": any("contributing" in f for f in files_lower),
"code_of_conduct": any("code_of_conduct" in f for f in files_lower),
"changelog": any("changelog" in f for f in files_lower),
"security": any("security" in f for f in files_lower),
"docs_folder": any(f.startswith("docs/") for f in files_lower),
"examples": any("example" in f for f in files_lower),
"tests": any("test" in f and (f.endswith(".py") or f.endswith(".js")) for f in files_lower),
"ci": any(f.startswith(".github/workflows/") for f in files_lower),
"dockerfile": any("dockerfile" in f for f in files_lower),
"makefile": any("makefile" in f for f in files_lower),
}
checks["score"] = round(sum(1 for v in checks.values() if v) / len(checks) * 100, 1)
checks["total_files"] = len(files)
return checks

def _estimate_traffic(self):
stars = self.metrics.get("stars", 0)
forks = self.metrics.get("forks", 0)
watchers = self.metrics.get("watchers", 0)
age_days = max(1, self.metrics.get("age_days", 1))

monthly = int((stars * 10) + (forks * 30) + (watchers * 5) + (age_days / 30 * 5))
weekly = int(monthly / 4.3)
daily = int(monthly / 30)
monthly_clones = int(monthly * 0.15)

return {
"monthly_views_est": monthly,
"weekly_views_est": weekly,
"daily_views_est": daily,
"monthly_clones_est": monthly_clones,
}

# ══════════════════════════════════════════════════════════════════════
# SMART FILTER ISSUES (nouveau v3)
# ══════════════════════════════════════════════════════════════════════
def _analyze_issues_smart(self):
"""Detecte les issues mortes, stale, ou a fermer"""
issues = self.data.get("issues_open", [])
if not isinstance(issues, list):
return {"error": "no_issues"}

now = datetime.now(timezone.utc)
analysis = {
"total_open": len(issues),
"dead": [], # > 3 mois sans activité
"stale": [], # > 1 mois sans activité
"active": [], # recent
"with_label_bug": [],
"with_label_good_first": [],
"with_label_help_wanted": [],
"unassigned": [],
"no_comments": [],
}

for iss in issues:
if iss.get("pull_request"):
continue

try:
created = datetime.fromisoformat(iss["created_at"].replace("Z", "+00:00"))
updated = datetime.fromisoformat(iss["updated_at"].replace("Z", "+00:00"))
days_created = (now - created).days
days_updated = (now - updated).days
except Exception:
continue

labels = [l["name"].lower() for l in iss.get("labels", [])]

entry = {
"number": iss["number"],
"title": iss["title"][:80],
"author": iss["user"]["login"],
"created_at": iss["created_at"][:10],
"updated_at": iss["updated_at"][:10],
"days_since_update": days_updated,
"days_since_creation": days_created,
"comments": iss.get("comments", 0),
"labels": labels,
"html_url": iss["html_url"],
}

if days_updated > 90:
analysis["dead"].append(entry)
elif days_updated > 30:
analysis["stale"].append(entry)
else:
analysis["active"].append(entry)

if "bug" in labels:
analysis["with_label_bug"].append(entry)
if "good first issue" in labels or "good-first-issue" in labels:
analysis["with_label_good_first"].append(entry)
if "help wanted" in labels or "help-wanted" in labels:
analysis["with_label_help_wanted"].append(entry)
if iss.get("assignee") is None:
analysis["unassigned"].append(entry)
if iss.get("comments", 0) == 0:
analysis["no_comments"].append(entry)

# Trier par anciennete
analysis["dead"].sort(key=lambda x: -x["days_since_update"])
analysis["stale"].sort(key=lambda x: -x["days_since_update"])
analysis["active"].sort(key=lambda x: -x["days_since_update"])

# Recommandations
analysis["recommendations"] = []
if len(analysis["dead"]) > 0:
analysis["recommendations"].append({
"action": "close_batch",
"count": len(analysis["dead"]),
"message": str(len(analysis["dead"])) + " issue(s) inactive(s) depuis >90 jours - proposer fermeture",
"issues": [i["number"] for i in analysis["dead"][:20]],
})
if len(analysis["no_comments"]) > 5:
analysis["recommendations"].append({
"action": "review",
"count": len(analysis["no_comments"]),
"message": str(len(analysis["no_comments"])) + " issue(s) sans aucun commentaire",
})
if len(analysis["unassigned"]) > 10:
analysis["recommendations"].append({
"action": "assign",
"count": len(analysis["unassigned"]),
"message": str(len(analysis["unassigned"])) + " issue(s) non assignee(s)",
})

return analysis

def generate_close_commands(self):
"""Genere les commandes gh CLI pour fermer les issues mortes"""
dead = self.issues_analysis.get("dead", [])
if not dead:
return []
commands = []
for iss in dead[:50]:
commands.append("gh issue close " + str(iss["number"]) + " --repo " + self.full + " --comment \"Fermeture automatique : inactif depuis " + str(iss["days_since_update"]) + " jours\"")
return commands

# ══════════════════════════════════════════════════════════════════════
# SCORES
# ══════════════════════════════════════════════════════════════════════
def compute_scores(self):
m = self.metrics

star_score = min(100, math.log10(max(1, m["stars"]) + 1) * 25)
fork_score = min(100, math.log10(max(1, m["forks"]) + 1) * 25)
watch_score = min(100, math.log10(max(1, m["watchers"]) + 1) * 25)
self.scores["popularity"] = round(star_score * 0.6 + fork_score * 0.25 + watch_score * 0.15, 2)

if m["days_since_push"] <= 1: fresh = 100
elif m["days_since_push"] <= 7: fresh = 90
elif m["days_since_push"] <= 30: fresh = 75
elif m["days_since_push"] <= 90: fresh = 50
elif m["days_since_push"] <= 365: fresh = 25
else: fresh = 5
commit_score = min(100, math.log10(max(1, m["recent_commits"]) + 1) * 35)
self.scores["activity"] = round(fresh * 0.6 + commit_score * 0.4, 2)

self.scores["documentation"] = m["documentation"]["score"]

issue_score = m["issue_resolution_rate"] if m["issues_total"] >= 5 else 50
pr_score = min(100, math.log10(max(1, m["pulls_open_count"] + m["pulls_closed_count"]) + 1) * 35)
branch_score = min(100, math.log10(max(1, m["branches"]) + 1) * 30)
self.scores["quality"] = round(issue_score * 0.5 + pr_score * 0.3 + branch_score * 0.2, 2)

contrib_score = min(100, math.log10(max(1, m["contributors"]) + 1) * 40)
fork_net = min(100, math.log10(max(1, m["forks"]) + 1) * 30)
self.scores["community"] = round(contrib_score * 0.6 + fork_net * 0.4, 2)

r = self.data["repo"]
maint = 100
if r.get("archived"): maint -= 40
if r.get("disabled"): maint -= 50
if r.get("fork"): maint -= 20
if m["releases"] > 0: maint = min(100, maint + 10)
self.scores["maintenance"] = max(0, maint)

lang_score = min(100, m["languages_count"] * 15)
if m["languages"]:
top = max(m["languages"].values())
div = min(100, (1 - top / 100) * 150)
else:
div = 0
self.scores["languages"] = round(lang_score * 0.5 + div * 0.5, 2)

size = m["size_kb"]
if size < 10: size_score = 20
elif size < 100: size_score = 40
elif size < 1000: size_score = 65
elif size < 10000: size_score = 85
elif size < 100000: size_score = 100
else: size_score = 90
self.scores["size"] = size_score

self.scores["momentum"] = self._momentum()

def _momentum(self):
commits = self.data.get("commits", [])
if not isinstance(commits, list) or not commits:
return 30
now = datetime.now(timezone.utc)
recent = 0
older = 0
for c in commits:
try:
date_str = c.get("commit", {}).get("author", {}).get("date", "")
dt = datetime.fromisoformat(date_str.replace("Z", "+00:00"))
days = (now - dt).days
if days <= 90: recent += 1
elif days <= 365: older += 1
except Exception:
continue
if older == 0:
return 90 if recent > 10 else (70 if recent > 0 else 40)
ratio = recent / older
if ratio > 2: return 100
if ratio > 1: return 85
if ratio > 0.5: return 65
if ratio > 0.2: return 45
return 25

def compute_global(self):
weights = {
"popularity": 0.20, "activity": 0.20, "documentation": 0.15,
"quality": 0.15, "community": 0.15, "maintenance": 0.05,
"languages": 0.05, "size": 0.05,
}
global_score = sum(self.scores.get(k, 0) * w for k, w in weights.items())
global_score = global_score * 0.95 + self.scores.get("momentum", 50) * 0.05
self.scores["global"] = round(global_score, 2)
self.scores["_weights"] = weights

if global_score >= 90:
self.scores["grade"] = "S"; self.scores["verdict"] = "EXCEPTIONNEL"; self.scores["color"] = "#00ff9d"
elif global_score >= 80:
self.scores["grade"] = "A"; self.scores["verdict"] = "EXCELLENT"; self.scores["color"] = "#4ade80"
elif global_score >= 70:
self.scores["grade"] = "B"; self.scores["verdict"] = "TRES BON"; self.scores["color"] = "#a3e635"
elif global_score >= 60:
self.scores["grade"] = "C"; self.scores["verdict"] = "BON"; self.scores["color"] = "#fbbf24"
elif global_score >= 50:
self.scores["grade"] = "D"; self.scores["verdict"] = "MOYEN"; self.scores["color"] = "#fb923c"
elif global_score >= 35:
self.scores["grade"] = "E"; self.scores["verdict"] = "FAIBLE"; self.scores["color"] = "#f87171"
else:
self.scores["grade"] = "F"; self.scores["verdict"] = "DEBUTANT"; self.scores["color"] = "#ef4444"

def analyze(self):
if not self.fetch():
return {"error": "Repo introuvable"}
self.compute_metrics()
self.compute_scores()
self.compute_global()

r = self.data["repo"]
return {
"ok": True,
"version": VERSION,
"timestamp": datetime.now(timezone.utc).isoformat(),
"repo": {
"full_name": r.get("full_name"),
"description": r.get("description"),
"url": r.get("html_url"),
"homepage": r.get("homepage"),
"owner": {
"login": (r.get("owner") or {}).get("login"),
"avatar": (r.get("owner") or {}).get("avatar_url"),
},
"license": self.metrics["license"],
"language": self.metrics["language"],
"topics": self.metrics["topics"],
"default_branch": r.get("default_branch"),
},
"metrics": self.metrics,
"scores": self.scores,
"issues_analysis": self.issues_analysis,
"close_commands": self.generate_close_commands(),
"links": {
"repo": r.get("html_url"),
"issues": r.get("html_url") + "/issues",
"pulls": r.get("html_url") + "/pulls",
"releases": r.get("html_url") + "/releases",
"contributors": r.get("html_url") + "/graphs/contributors",
"network": r.get("html_url") + "/network",
"actions": r.get("html_url") + "/actions",
"insights": r.get("html_url") + "/pulse",
"graphs": r.get("html_url") + "/graphs/traffic",
},
"api": {
"requests_made": self.client.request_count,
"rate_remaining": self.client.rate_remaining,
"rate_limit": self.client.rate_limit,
},
}


# ══════════════════════════════════════════════════════════════════════════════
# BATCH MODE (nouveau v3)
# ══════════════════════════════════════════════════════════════════════════════
class BatchAnalyzer:

def __init__(self, client):
self.client = client

def analyze_batch(self, repos: List[str], progress_callback=None) -> Dict:
"""Analyse plusieurs repos en batch"""
results = []
total = len(repos)

for i, repo_str in enumerate(repos, 1):
owner, repo = parse_url(repo_str)
if not owner or not repo:
results.append({"input": repo_str, "error": "invalid_url"})
continue

if progress_callback:
progress_callback(i, total, owner + "/" + repo)

engine = AnalyticsEngine(self.client, owner, repo)
try:
result = engine.analyze()
result["input"] = repo_str
results.append(result)
except Exception as e:
results.append({"input": repo_str, "error": str(e)})

return self._compare(results)

def _compare(self, results: List[Dict]) -> Dict:
"""Compare les resultats et genere un classement"""
valid = [r for r in results if r.get("ok")]

if not valid:
return {"error": "Aucun repo valide", "results": results}

# Classements par critere
rankings = {}

criteria = [
("global", "Score global"),
("popularity", "Popularite"),
("activity", "Activite"),
("documentation", "Documentation"),
("quality", "Qualite"),
("community", "Communaute"),
]

for key, label in criteria:
sorted_repos = sorted(valid, key=lambda x: x["scores"].get(key, 0), reverse=True)
rankings[key] = [
{
"rank": i + 1,
"repo": r["repo"]["full_name"],
"score": round(r["scores"].get(key, 0), 2),
"grade": r["scores"]["grade"],
}
for i, r in enumerate(sorted_repos)
]

# Statistiques comparatives
all_scores = {
"stars": [(r["repo"]["full_name"], r["metrics"]["stars"]) for r in valid],
"forks": [(r["repo"]["full_name"], r["metrics"]["forks"]) for r in valid],
"contributors": [(r["repo"]["full_name"], r["metrics"]["contributors"]) for r in valid],
"age_years": [(r["repo"]["full_name"], r["metrics"]["age_years"]) for r in valid],
}

# Repos les mieux documentes
best_doc = max(valid, key=lambda x: x["scores"].get("documentation", 0))

# Repos les plus actifs
best_act = max(valid, key=lambda x: x["scores"].get("activity", 0))

# Repos les plus populaires
best_pop = max(valid, key=lambda x: x["scores"].get("popularity", 0))

# Insights
insights = []
insights.append({
"question": "Lequel est le mieux documente ?",
"answer": best_doc["repo"]["full_name"],
"score": round(best_doc["scores"].get("documentation", 0), 2),
})
insights.append({
"question": "Lequel est le plus actif ?",
"answer": best_act["repo"]["full_name"],
"score": round(best_act["scores"].get("activity", 0), 2),
})
insights.append({
"question": "Lequel est le plus populaire ?",
"answer": best_pop["repo"]["full_name"],
"score": round(best_pop["scores"].get("popularity", 0), 2),
})

# Moyennes
averages = {
"global_score": round(statistics.mean(r["scores"]["global"] for r in valid), 2),
"stars": round(statistics.mean(r["metrics"]["stars"] for r in valid), 0),
"forks": round(statistics.mean(r["metrics"]["forks"] for r in valid), 0),
"contributors": round(statistics.mean(r["metrics"]["contributors"] for r in valid), 1),
}

# Repo le plus complet
best_overall = max(valid, key=lambda x: x["scores"]["global"])

return {
"ok": True,
"timestamp": datetime.now(timezone.utc).isoformat(),
"total_repos": len(valid),
"results": valid,
"failed": [r for r in results if not r.get("ok")],
"rankings": rankings,
"insights": insights,
"averages": averages,
"best_overall": {
"repo": best_overall["repo"]["full_name"],
"score": best_overall["scores"]["global"],
"grade": best_overall["scores"]["grade"],
},
"comparative_metrics": all_scores,
}

def save_batch_report(self, batch_result: Dict) -> str:
ts = datetime.now().strftime("%Y%m%d_%H%M%S")
path = BATCH_DIR / ("batch_" + ts + ".json")
path.write_text(
json.dumps(batch_result, indent=2, ensure_ascii=False, default=str),
encoding="utf-8"
)
return str(path)


